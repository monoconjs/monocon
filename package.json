{
  "name": "monocon",
  "version": "0.1.1",
  "description": "A web-standard HTTP framework for TypeScript with typed, chainable routes and middleware-provided context inference.",
  "keywords": [
    "framework",
    "http",
    "middleware",
    "routing",
    "typescript",
    "web-standard",
    "zod"
  ],
  "homepage": "https://github.com/monoconjs/monocon#readme",
  "bugs": "https://github.com/monoconjs/monocon/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monoconjs/monocon.git"
  },
  "bin": {
    "monocon": "./bin/monocon.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "global": [
        "./dist/global.d.mts"
      ],
      "config": [
        "./dist/config.d.mts"
      ],
      "node": [
        "./dist/adapters/node.d.mts"
      ],
      "bun": [
        "./dist/adapters/bun.d.mts"
      ],
      "deno": [
        "./dist/adapters/deno.d.mts"
      ],
      "workers": [
        "./dist/adapters/workers.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./global": {
      "import": {
        "types": "./dist/global.d.mts",
        "default": "./dist/global.mjs"
      },
      "require": {
        "types": "./dist/global.d.cts",
        "default": "./dist/global.cjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.mts",
        "default": "./dist/config.mjs"
      },
      "require": {
        "types": "./dist/config.d.cts",
        "default": "./dist/config.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/adapters/node.d.mts",
        "default": "./dist/adapters/node.mjs"
      },
      "require": {
        "types": "./dist/adapters/node.d.cts",
        "default": "./dist/adapters/node.cjs"
      }
    },
    "./bun": {
      "import": {
        "types": "./dist/adapters/bun.d.mts",
        "default": "./dist/adapters/bun.mjs"
      },
      "require": {
        "types": "./dist/adapters/bun.d.cts",
        "default": "./dist/adapters/bun.cjs"
      }
    },
    "./deno": {
      "import": {
        "types": "./dist/adapters/deno.d.mts",
        "default": "./dist/adapters/deno.mjs"
      },
      "require": {
        "types": "./dist/adapters/deno.d.cts",
        "default": "./dist/adapters/deno.cjs"
      }
    },
    "./workers": {
      "import": {
        "types": "./dist/adapters/workers.d.mts",
        "default": "./dist/adapters/workers.mjs"
      },
      "require": {
        "types": "./dist/adapters/workers.d.cts",
        "default": "./dist/adapters/workers.cjs"
      }
    }
  },
  "scripts": {
    "build": "pnpm --filter @monocon/compiler build && pnpm --filter @monocon/core build && pnpm --filter @monocon/adapter build && tsdown && pnpm --filter playground build",
    "check:package": "publint && attw --pack .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run && pnpm -r test",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "dev": "pnpm --filter playground dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@monocon/adapter": "workspace:*",
    "@monocon/compiler": "workspace:*",
    "@monocon/core": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "5.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2007",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.4"
}
