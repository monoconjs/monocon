{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "description": "Playground.",
  "type": "module",
  "scripts": {
    "dev": "monocon gen tsx watch src/index.ts",
    "gen": "monocon gen",
    "typecheck": "monocon gen && tsc --noEmit",
