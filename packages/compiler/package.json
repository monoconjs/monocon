{
  "name": "@monocon/compiler",
  "version": "0.3.0",
  "description": "Codegen CLI for monocon.",
  "license": "MIT",
  "bin": {
    "monocon": "./bin/monocon.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "type": "module",
  "main": "./dist/config.mjs",
  "types": "./dist/config.d.mts",
  "exports": {
    ".": {
      "types": "./dist/config.d.mts",
      "default": "./dist/config.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "default": "./dist/cli.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cac": "^6",
    "chokidar": "^6.0.0",
    "execa": "^9",
    "tinyglobby": "^0.2.15"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
