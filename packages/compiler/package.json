{
  "name": "@monocon/compiler",
  "version": "0.3.0",
  "description": "Declaration generator for monocon route modules.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "tinyglobby": "^0.2.17",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@monocon/config": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  }
}
