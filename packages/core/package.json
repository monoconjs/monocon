{
  "name": "@monocon/core",
  "version": "0.3.0",
  "description": "Platform-neutral core runtime for monocon.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./global": {
      "import": {
        "types": "./dist/global.d.mts",
        "default": "./dist/global.mjs"
      },
      "require": {
        "types": "./dist/global.d.cts",
        "default": "./dist/global.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
